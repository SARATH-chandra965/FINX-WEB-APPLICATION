# Public Vercel origin; app sends analysis and assistant requests to this service.
EXPO_PUBLIC_FINX_API_URL=

# Firebase Web app configuration. These client identifiers are public;
# never put service-account keys or private model keys in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Server-side Vercel environment variable only. Never prefix this with EXPO_PUBLIC_.
# Do not place the real key in an app build or commit it to source control.
GEMINI_API_KEY=